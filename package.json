{
  "name": "return-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests",
    "test:browser": "playwright test",
    "pretest:browser": "npm run build"
  },
  "dependencies": {
    "@fontsource/lora": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@upstash/redis": "1.39.0",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

# Local development uses durable SQLite in ./data and a locally generated signing key.
# Hosted deployments must provide these; never commit real values.
RR_PUBLIC_ORIGIN=http://127.0.0.1:4318
# RR_SIGNING_SECRET=<at-least-32-random-characters>
# UPSTASH_REDIS_REST_URL=<dedicated-or-approved-existing-store-url>
# UPSTASH_REDIS_REST_TOKEN=<private-server-only-token>
